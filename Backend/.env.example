# ---- Django ----
# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database (PostgreSQL) ----
# Use "sqlite" only for quick local experiments; PostgreSQL is the real target
DB_ENGINE=postgresql
DB_NAME=deas_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ---- CORS / Frontend ----
# Comma-separated list of React (Vite) origins that may call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Email (SMTP) ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=DEAS <your-email@gmail.com>

# ---- JWT lifetimes ----
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ---- OTP ----
OTP_VALID_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ---- Production only ----
# Number of reverse proxies in front of Django (so throttling sees the real client IP)
NUM_PROXIES=0

# ---- Media / Profiles module ----
# Where uploaded profile pictures and cover photos are stored (local development)
MEDIA_ROOT=media
MEDIA_URL=media/
# Optional: use object storage in production (needs the matching package, e.g. django-storages)
# MEDIA_STORAGE_BACKEND=storages.backends.s3.S3Storage
PROFILE_PICTURE_MAX_BYTES=2097152
PROFILE_COVER_MAX_BYTES=5242880
PROFILE_UPLOAD_RATE=30/hour

# ---- Friends module (all optional) ----
FRIENDS_REQUEST_RATE=30/hour
FRIENDS_ACTION_RATE=300/hour
# Hours a sender must wait before re-requesting someone who rejected them (0 = no cool-down)
FRIENDS_REJECTION_COOLDOWN_HOURS=24
# False = the status API reports "not_friends" instead of "blocked_you"
FRIENDS_REVEAL_BLOCKED_BY_OTHER=True
# Temporary GET /api/friends/discover/ (turn off once the Search module exists)
FRIENDS_ENABLE_TEMP_DISCOVERY=True

# ---- Redis (REQUIRED in production) ----
# Shared cache (throttling, presence, WebSocket tickets) AND the Channels layer for WebSockets.
# Without it (DEBUG only) an in-memory layer is used, which works in ONE process only.
# REDIS_URL=redis://localhost:6379/0

# ---- Social module (all optional) ----
SOCIAL_IMAGE_MAX_BYTES=5242880
SOCIAL_MAX_IMAGES_PER_POST=6
SOCIAL_POST_RATE=30/hour
SOCIAL_COMMENT_RATE=90/hour
SOCIAL_INTERACTION_RATE=600/hour
SOCIAL_REPORT_RATE=20/hour

# ---- Messaging module (all optional; see messaging/README.md) ----
# Non-friends may exchange this many messages IN TOTAL before they must become friends
MESSAGING_NON_FRIEND_MESSAGE_LIMIT=4
MESSAGING_MAX_MESSAGE_LENGTH=5000
# Minutes during which a message can be edited / deleted for everyone (0 = unlimited)
MESSAGING_EDIT_WINDOW_MINUTES=15
MESSAGING_DELETE_FOR_EVERYONE_WINDOW_MINUTES=60
MESSAGING_UNARCHIVE_ON_NEW_MESSAGE=True
MESSAGING_MAX_ATTACHMENTS_PER_MESSAGE=5
MESSAGING_IMAGE_MAX_BYTES=5242880
MESSAGING_FILE_MAX_BYTES=10485760
MESSAGING_ATTACHMENT_URL_MAX_AGE_SECONDS=600
# Private attachments live here (NOT under MEDIA_ROOT, never served by URL)
PRIVATE_MEDIA_ROOT=private_media
# Production: private object storage, e.g. storages.backends.s3.S3Storage (private bucket)
# MESSAGING_PRIVATE_STORAGE_BACKEND=storages.backends.s3.S3Storage
# Who sees online/last-seen: friends | participants | nobody
MESSAGING_PRESENCE_VISIBILITY=friends
MESSAGING_PRESENCE_TTL_SECONDS=70
MESSAGING_TYPING_TTL_SECONDS=6
MESSAGING_SEND_RATE=60/min
MESSAGING_ACTION_RATE=300/min
MESSAGING_UPLOAD_RATE=60/hour
MESSAGING_WS_EVENT_RATE=120/min
# Browser origins allowed to open WebSockets (defaults to CORS_ALLOWED_ORIGINS)
# MESSAGING_WS_ALLOWED_ORIGINS=https://app.example.com

# ---- Common module (shared upload limits) ----
COMMON_MAX_IMAGE_BYTES=5242880
COMMON_MAX_PDF_BYTES=10485760
# Production: private object storage for achievement evidence (private bucket), e.g.
# PRIVATE_STORAGE_BACKEND=storages.backends.s3.S3Storage

# ---- Announcements module (all optional) ----
ANNOUNCEMENT_COVER_MAX_BYTES=5242880
# Bookmarkers are reminded this many hours before the start (cron: send_announcement_reminders)
ANNOUNCEMENT_REMINDER_HOURS=24
# Who is notified when an announcement is published: friends | none
ANNOUNCEMENT_PUBLISH_AUDIENCE=friends
ANNOUNCEMENT_WRITE_RATE=60/hour
ANNOUNCEMENT_INTERACTION_RATE=600/hour
ANNOUNCEMENT_REPORT_RATE=20/hour
ANNOUNCEMENT_SEARCH_RATE=300/hour

# ---- Achievements module (all optional) ----
ACHIEVEMENT_EVIDENCE_IMAGE_MAX_BYTES=5242880
ACHIEVEMENT_EVIDENCE_PDF_MAX_BYTES=10485760
ACHIEVEMENT_MAX_EVIDENCE_FILES=10
ACHIEVEMENT_MAX_FEATURED=5
ACHIEVEMENT_EVIDENCE_URL_MAX_AGE_SECONDS=600
ACHIEVEMENT_WRITE_RATE=60/hour
ACHIEVEMENT_UPLOAD_RATE=60/hour
ACHIEVEMENT_REVIEW_RATE=600/hour

# ---- Notifications module (all optional) ----
# E-mail copies of important notifications. Defaults to True when EMAIL_HOST is set.
NOTIFICATIONS_EMAIL_ENABLED=True
# React app URL used for links inside notification e-mails
FRONTEND_BASE_URL=http://localhost:5173
NOTIFICATIONS_RETENTION_DAYS=90
NOTIFICATION_ACTION_RATE=600/hour
