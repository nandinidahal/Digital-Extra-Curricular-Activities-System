# Base URL of the Django backend (no trailing slash). Never put secrets in VITE_* variables:
# everything prefixed with VITE_ is bundled into the public JavaScript.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Optional: WebSocket base URL. Defaults to VITE_API_BASE_URL with http->ws / https->wss.
# VITE_WS_BASE_URL=ws://127.0.0.1:8000
